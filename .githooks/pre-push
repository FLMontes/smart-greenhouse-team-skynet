#!/bin/sh
set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"

echo "Running backend unit tests..."
cd "$ROOT_DIR/backend/spring/final-project"

if [ -f "./gradlew" ]; then
    ./gradlew test
elif [ -f "./gradlew.bat" ]; then
    cmd.exe /c gradlew.bat test
else
    echo "Gradle wrapper not found."
    exit 1
fi

echo "Running frontend unit tests..."
cd "$ROOT_DIR/frontend/dashboard"
npm test -- --run

echo "Running firmware unit tests..."
cd "$ROOT_DIR/firmware/esp32"
pio test -e native_test

echo "Pre-push tests completed successfully."